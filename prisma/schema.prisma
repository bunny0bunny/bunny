// Bunny Library — Release A–E schema (mirrors docs/ARCHITECTURE.md §3; B adds novels,
// library, community; E adds notifications + comment likes). Runtime database: Neon PostgreSQL (founder-approved migration, DECISIONS.md D-28).
//   - DATABASE_URL → Neon POOLED connection string (application runtime, serverless-safe)
//   - DIRECT_URL   → Neon DIRECT (non-pooled) connection string (Prisma migrations / CLI)
// Prisma is the ORM and migration tool (versioned migrations in prisma/migrations);
// NextAuth remains the authentication layer. Supabase is NOT used at runtime.
// NOTE: authorization is enforced at the application layer (middleware → admin layout
// → requireRole on every admin query/action). NO database-level RLS is configured on
// Neon — see README "What is enforced where" and docs/ARCHITECTURE.md §5 banner.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Native Postgres enums (replaces the SQLite string columns + code validators;
// constants.ts remains the source of truth for labels, zod schemas and session checks).

enum UserRole {
  reader
  contributor
  editor
  admin

  @@map("user_role")
}

enum SeriesFormat {
  manga
  webtoon
  novel

  @@map("series_format")
}

enum SeriesCategory {
  manga
  manhwa
  novel
  comic

  @@map("series_category")
}

enum SeriesStatus {
  ongoing
  completed
  hiatus

  @@map("series_status")
}

enum ChapterWorkflow {
  draft
  review
  published

  @@map("chapter_workflow")
}

enum ReadingDirection {
  rtl
  ltr

  @@map("reading_direction")
}

enum AnalyticsEventType {
  read_start
  read_page
  read_complete
  login
  publish

  @@map("analytics_event_type")
}

// Release E — notifications and comment likes
enum NotificationType {
  new_chapter
  comment_like
  system

  @@map("notification_type")
}

// Release B — library shelves and community moderation states
enum LibraryShelf {
  reading
  plan
  finished

  @@map("library_shelf")
}

enum CommentStatus {
  visible
  flagged
  hidden

  @@map("comment_status")
}

enum AccountTokenPurpose {
  verify
  reset
  invite

  @@map("account_token_purpose")
}

model Profile {
  id                    String             @id @default(cuid())
  email                 String             @unique
  nickname              String
  passwordHash          String
  role                  UserRole           @default(reader)
  avatarSeed            String             @default("v1")
  bio                   String?
  emailVerifiedAt       DateTime?
  disabledAt            DateTime?
  authVersion           Int                @default(0)
  onboardingCompletedAt DateTime?
  preferredGenresJson   String             @default("[]")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  readingProgress       ReadingProgress[]
  events                AnalyticsEvent[]
  libraryItems          LibraryItem[]
  comments              Comment[]
  commentReports        CommentReport[]
  ratings               Rating[]
  notifications         Notification[]
  commentLikes          CommentLike[]
  assignments           SeriesAssignment[]
  approvedRevisions     ChapterRevision[] @relation("RevisionApprovedBy")
  editorialEvents       ChapterEditorialEvent[]
  accountTokens         AccountToken[]
  contentRequests       ContentRequest[]
  chapterUploads        ChapterUpload[]
}

model AccountToken {
  id          String              @id @default(cuid())
  tokenHash   String              @unique
  purpose     AccountTokenPurpose
  profileId   String?
  createdById String?
  createdByAuthVersion Int?
  email       String
  role        UserRole?
  expiresAt   DateTime
  consumedAt  DateTime?
  revokedAt   DateTime?
  nextPath    String?
  createdAt   DateTime            @default(now())
  profile     Profile?            @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([profileId])
}

model AccountAudit {
  id        String   @id @default(cuid())
  actorId   String?
  targetId  String?
  action    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([action])
}

model AccountRateLimit {
  id        String   @id @default(cuid())
  keyHash   String   @unique
  count     Int      @default(1)
  windowEnd DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([keyHash, windowEnd])
}

model Series {
  id            String             @id @default(cuid())
  deletedAt     DateTime?
  trashBatchId  String?
  slug          String             @unique
  titleAr       String
  titleOriginal String?
  synopsisAr    String
  category      SeriesCategory?
  format        SeriesFormat
  status        SeriesStatus       @default(ongoing)
  genresJson    String             @default("[]")
  tagsJson      String             @default("[]")
  author        String
  translator    String?
  coverPath     String
  accent        String             @default("#9B7BFF")
  isAdult       Boolean            @default(false)
  isFeatured    Boolean            @default(false)
  ratingAvg     Float              @default(0)
  ratingCount   Int                @default(0)
  displayOrder  Int                @default(0)
  reads         Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  chapters      Chapter[]
  progress      ReadingProgress[]
  events        AnalyticsEvent[]
  libraryItems  LibraryItem[]
  comments      Comment[]
  ratings       Rating[]
  contentRequests ContentRequest[]
  assignments   SeriesAssignment[]

  @@index([category])
  @@index([deletedAt])
  @@index([trashBatchId])
}

model SeriesAssignment {
  id        String   @id @default(cuid())
  profileId String
  seriesId  String
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([profileId, seriesId])
  @@index([seriesId])
}

model Chapter {
  id               String           @id @default(cuid())
  deletedAt        DateTime?
  trashBatchId     String?
  seriesId         String
  number           Int
  titleAr          String
  workflow         ChapterWorkflow  @default(draft)
  publishedAt      DateTime?
  scheduledFor     DateTime?
  isPremiumDemo    Boolean          @default(false)
  readingDirection ReadingDirection @default(rtl)
  novelBody        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  series           Series           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  pages            ChapterPage[]
  progress         ReadingProgress[]
  comments         Comment[]
  revisions        ChapterRevision[]
  uploads          ChapterUpload[]
  mediaAssets      MediaAsset[]
  editorialEvents  ChapterEditorialEvent[]

  @@unique([seriesId, number])
  @@index([deletedAt])
  @@index([trashBatchId])
}

// Durable deletion journal: intentionally survives purging the owned content.
model ContentTrash {
  id             String   @id @default(cuid())
  activeKey      String?  @unique
  entityType     String
  entityId       String
  seriesId       String?
  title          String
  deletedById    String?
  deletedAt      DateTime @default(now())
  purgeAfter     DateTime
  state          String   @default("trashed")
  version        Int      @default(1)
  objectsJson    Json     @default("[]")
  detailsJson    Json     @default("{}")
  errorCode      String?
  purgeStartedAt DateTime?
  purgedAt       DateTime?
  restoredAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([state, purgeAfter])
  @@index([entityType, entityId])
  @@index([seriesId])
}

enum ChapterRevisionStatus {
  draft
  review
  changes_requested
  approved
  scheduled
  published
  withdrawn

  @@map("chapter_revision_status")
}

model ChapterRevision {
  id               String                @id @default(cuid())
  chapterId        String
  revisionNumber   Int
  version          Int                   @default(1)
  status           ChapterRevisionStatus @default(draft)
  titleAr          String
  readingDirection ReadingDirection      @default(rtl)
  isPremiumDemo    Boolean               @default(false)
  novelBody        String?
  pagesJson        Json                  @default("[]")
  scheduledFor     DateTime?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  chapter          Chapter               @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  approvedBy       Profile?              @relation("RevisionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  events           ChapterEditorialEvent[]
  pendingUploadId  String? @unique
  pendingUpload    ChapterUpload? @relation("PendingChapterUpload", fields: [pendingUploadId], references: [id], onDelete: SetNull)
  uploads          ChapterUpload[] @relation("RevisionUploads")

  @@unique([chapterId, revisionNumber])
  @@index([chapterId, status])
}

model ChapterEditorialEvent {
  id          String           @id @default(cuid())
  chapterId   String
  revisionId  String?
  actorId     String?
  action      String
  reasonAr    String?
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now())

  chapter     Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  revision    ChapterRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  actor       Profile?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([chapterId, createdAt])
  @@index([revisionId])
  @@index([actorId])
}

model ChapterPage {
  id        String  @id @default(cuid())
  chapterId String
  pageIndex Int
  imagePath String
  width     Int     @default(800)
  height    Int     @default(1200)
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, pageIndex])
}

model ReadingProgress {
  id        String   @id @default(cuid())
  profileId String
  seriesId  String
  chapterId String
  pageIndex Int      @default(0)
  percent   Float    @default(0)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([profileId, chapterId])
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  seriesId  String?
  chapterId String?
  profileId String?
  metaJson  String             @default("{}")
  createdAt DateTime           @default(now())
  profile   Profile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  series    Series?            @relation(fields: [seriesId], references: [id], onDelete: SetNull)
}

model EditorialCollection {
  id              String  @id @default(cuid())
  slug            String  @unique
  titleAr         String
  descriptionAr   String
  theme           String  @default("violet")
  displayOrder    Int     @default(0)
  isFeatured      Boolean @default(false)
  seriesSlugsJson String  @default("[]") // ordered slugs; normalized join table deferred (prototype scope)
}

// ─── Release B — personal library, community, ratings ───

model LibraryItem {
  id        String       @id @default(cuid())
  profileId String
  seriesId  String
  shelf     LibraryShelf @default(reading)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  series    Series       @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([profileId, seriesId])
}

model Comment {
  id        String        @id @default(cuid())
  profileId String
  seriesId  String
  chapterId String?
  body      String
  status    CommentStatus @default(visible)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  series    Series        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  chapter   Chapter?      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  reports   CommentReport[]
  likes     CommentLike[]

  @@index([seriesId, status])
  @@index([chapterId])
  @@index([profileId])
}

// Release E — one like per profile per comment
model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  profileId String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([commentId, profileId])
  @@index([profileId])
}

// Release E — in-app notification center (bell + /notifications)
model Notification {
  id        String           @id @default(cuid())
  profileId String
  type      NotificationType
  titleAr   String
  bodyAr    String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  profile   Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, readAt, createdAt])
}

model CommentReport {
  id        String   @id @default(cuid())
  commentId String
  profileId String
  reasonAr  String?
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([commentId, profileId])
}

model Rating {
  id        String   @id @default(cuid())
  profileId String
  seriesId  String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([profileId, seriesId])
}


enum ChapterUploadState {
  uploading
  ready
  failed
  cancelled
  superseded
}

model ChapterUpload {
  id String @id @default(cuid())
  revisionId String
  chapterId String
  createdById String
  state ChapterUploadState @default(uploading)
  sourceName String
  sourceBytes Int
  sourceSha256 String?
  processingProfile String?
  keepSource Boolean @default(true)
  sourceReviewedAt DateTime?
  sourceDeleteAfter DateTime?
  sourceDeletedAt DateTime?
  sourceDeletingAt DateTime?
  completedAt DateTime?
  expectedPages Int
  reservedBytes Int @default(0)
  revisionVersion Int
  errorCode String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revision ChapterRevision @relation("RevisionUploads", fields: [revisionId], references: [id], onDelete: Cascade)
  pendingRevision ChapterRevision? @relation("PendingChapterUpload")
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdBy Profile @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assets MediaAsset[]
  @@index([createdById, state, expiresAt])
  @@index([state, keepSource, sourceDeletedAt, sourceDeleteAfter], map: "ChapterUpload_source_retention_idx")
  @@index([revisionId])
}

model MediaAsset {
  id String @id @default(cuid())
  uploadId String
  chapterId String
  pageIndex Int
  objectKey String @unique
  mime String
  bytes Int
  width Int?
  height Int?
  readyAt DateTime?
  createdAt DateTime @default(now())
  upload ChapterUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  @@unique([uploadId, pageIndex])
  @@index([chapterId])
}

enum ContentRequestStatus {
  new
  reviewing
  preparing
  available
  declined
  @@map("content_request_status")
}

model ContentRequest {
  id String @id @default(cuid())
  profileId String
  title String
  category SeriesCategory
  referenceUrl String?
  message String?
  normalizedTitle String
  submissionId String
  reply String?
  internalNote String?
  status ContentRequestStatus @default(new)
  statusNote String?
  fulfilledSeriesId String?
  mergedIntoId String?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile Profile @relation(fields:[profileId], references:[id], onDelete:Cascade)
  fulfilledSeries Series? @relation(fields:[fulfilledSeriesId], references:[id], onDelete:SetNull)
  mergedInto ContentRequest? @relation("RequestGroup", fields:[mergedIntoId], references:[id], onDelete:Restrict)
  members ContentRequest[] @relation("RequestGroup")
  @@unique([profileId,submissionId])
  @@unique([profileId,category,normalizedTitle])
  @@index([profileId,createdAt])
  @@index([mergedIntoId,status,createdAt])
  @@index([fulfilledSeriesId])
}
